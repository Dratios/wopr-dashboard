# Copier en `.env` à côté du docker-compose.yml, puis : chmod 600 .env
# Ce fichier contient des secrets — il ne doit JAMAIS être versionné (§7).
#
# DEPUIS L'ONGLET PARAMÈTRES : la plupart de ces valeurs se règlent désormais
# dans l'interface. Elles atterrissent alors dans `config/settings.yaml`, qui
# prime sur ce fichier. Le .env reste la valeur d'amorçage — et le moyen de se
# dépanner si le fichier de réglages devient illisible.
# Les variables lues à la création du conteneur (BIND_ADDR, BIND_PORT,
# WOPR_SESSION_SECRET, WOPR_COOKIE_SECURE, WOPR_DB_*) sont, elles, réécrites
# directement ici par le dashboard, qui signale ensuite qu'une recréation
# (`docker compose up -d`) est nécessaire.
#
# Générer les valeurs ci-dessous :
#     python3 scripts/wopr-passwd.py --secret admin
#
# Le script n'utilise que la bibliothèque standard (scrypt de hashlib) : aucune
# dépendance à installer, il tourne avec le Python de la machine.

# Signature des cookies de session. Le changer ferme toutes les sessions ouvertes.
WOPR_SESSION_SECRET=

# Comptes autorisés : `utilisateur:empreinte_scrypt`, séparés par des virgules.
# Sert à l'amorçage : une fois le mot de passe changé depuis l'onglet Paramètres,
# l'empreinte vit dans `config/settings.yaml` et c'est elle qui fait foi.
# Un seul compte administrateur est prévu. Pour en ajouter un second plus tard,
# relancer le script et concaténer les deux entrées.
# Garder les apostrophes : l'empreinte contient des `$` que docker compose
# interpréterait comme des variables.
WOPR_USERS=''

# Étiquette `com.wopr.owner` correspondant à la personne aux commandes.
# Réglable à chaud dans Paramètres → Général.
# Le compte de connexion (`admin`) et l'appartenance des conteneurs sont deux
# choses distinctes : cette valeur dit quels conteneurs sont « les vôtres », et
# donc lesquels déclenchent un avertissement parce qu'ils sont à l'autre admin.
WOPR_OWNER_IDENTITY=lux

# Adresse d'écoute. Mettre l'IP de la machine sur le réseau local pour que le
# dashboard soit joignable depuis le LAN, et seulement de là. 127.0.0.1 le
# réserve à la machine elle-même. Éviter 0.0.0.0, qui l'expose sur toutes les
# interfaces — y compris celles que vous n'aviez pas prévues.
BIND_ADDR=127.0.0.1
BIND_PORT=8080

# Ollama, pour la vue des modèles chargés. Le conteneur étant en réseau hôte,
# l'adresse de bouclage de la machine convient.
WOPR_OLLAMA_URL=http://127.0.0.1:11434

# DEBUG pour tracer les appels, INFO en fonctionnement normal.
WOPR_LOG_LEVEL=INFO

# Passer à 1 le jour où un reverse proxy TLS est placé devant le dashboard :
# le cookie de session ne sera alors plus émis en clair.
WOPR_COOKIE_SECURE=0

# Notifications Telegram. Ces quatre variables ne sont plus que l'amorçage : le
# détail (familles d'alerte, heures calmes, délai de confirmation, groupement,
# débit maximal, événements d'exploitation) se règle dans Paramètres →
# Notifications. Laisser vide ici pour tout configurer depuis l'interface.
#
# 1. Bot créé via @BotFather → le jeton est WOPR_TELEGRAM_BOT_TOKEN.
# 2. Envoyer un message quelconque à ce bot (Telegram ne connaît le chat_id
#    qu'après ce premier message).
# 3. Récupérer le chat_id : ouvrir dans un navigateur
#        https://api.telegram.org/bot<VOTRE_JETON>/getUpdates
#    et lire "message" → "chat" → "id". Plus simple : parler à @userinfobot
#    (ou @RawDataBot) sur Telegram, il répond directement avec le chat_id.
WOPR_TELEGRAM_BOT_TOKEN=
WOPR_TELEGRAM_CHAT_ID=

# Niveau minimal : "err" (critiques seulement), "warn" (avertissements et plus)
# ou "info" (tout). Chaque famille d'alerte peut s'en écarter dans l'interface.
WOPR_TELEGRAM_MIN_LEVEL=warn

# Anti-répétition (secondes) avant de renotifier une même alerte qui
# clignote. La résolution, elle, est toujours notifiée sans délai.
WOPR_TELEGRAM_COOLDOWN_S=900

# Mot de passe de la base d'historique (service `db`, joignable seulement depuis
# la machine). Hexadécimal : il ne contient ni `$` ni caractère à échapper.
#     openssl rand -hex 24
# Fixé au premier démarrage de la base : le changer ensuite demande aussi un
# ALTER USER dans PostgreSQL.
WOPR_DB_PASSWORD=

# Durée de conservation de l'historique, en heures. Les graphes montrent au plus
# 6 h ; la marge permet d'élargir plus tard sans repartir de zéro.
WOPR_HISTORY_RETENTION_H=24
